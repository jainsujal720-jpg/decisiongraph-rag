APP_NAME=DecisionGraph RAG
APP_ENV=development
LOG_LEVEL=INFO

# Local-machine addresses. Docker Compose overrides these inside the API container.
POSTGRES_URL=postgresql://decisiongraph:decisiongraph@localhost:5432/decisiongraph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=decisiongraph-local
REDIS_URL=redis://localhost:6379/0

# Stage 3 uses this key for document and query embeddings. Never commit the real value.
OPENAI_API_KEY=
# Answer drafting and citation verification go through RelayGuard when this URL is set.
# Embeddings and graph extraction still use OPENAI_API_KEY directly in this stage.
RELAYGUARD_URL=http://localhost:8100
RELAYGUARD_API_KEY=
RELAYGUARD_TIMEOUT_SECONDS=120
RELAYGUARD_PROVIDER_TIMEOUT_SECONDS=60
# Use openai for schema-valid answers; mock is only for safe gateway demonstrations.
RELAYGUARD_PROVIDER_MODE=openai
# Jev routes model calls, never generates the answer. Start in shadow mode to compare safely.
# Obtain a TypeSafe key separately; do not paste it into either dashboard.
TYPESAFE_API_KEY=
RELAYGUARD_JEV_MODE=off
CAUSAL_DRAFT_OPTIMIZATION=false
# Stage 14 cloud upload is disabled until an existing private S3 bucket is configured.
CLOUD_S3_BUCKET=
CLOUD_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
RELAYGUARD_JEV_MODEL=jev-1.13.0
RELAYGUARD_JEV_MIN_CONFIDENCE=0.80
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=128
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_DEFAULT_LIMIT=8
RRF_CONSTANT=60
EXTRACTION_MODEL=gpt-4.1-mini
GENERATION_MODEL=gpt-4.1-mini
VERIFICATION_MODEL=gpt-4.1-mini
GRAPH_MAX_CHUNKS_PER_REQUEST=50
ORCHESTRATION_CANDIDATE_LIMIT=12
CONTEXT_MAX_TOKENS=3000
ANSWER_MAX_CLAIMS=6
MIN_GROUNDEDNESS=0.75
REVIEW_CONFIDENCE_THRESHOLD=0.80
# Set in shared deployments and send it as the X-API-Key header. Leave empty for local development.
API_ACCESS_KEY=
# 0 disables rate limiting. Use Redis in a shared/multi-replica deployment.
RATE_LIMIT_REQUESTS_PER_MINUTE=0
RATE_LIMIT_BACKEND=memory
# development keeps local learning friction-free. jwt validates identity-provider access tokens.
AUTH_MODE=development
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=decisiongraph-local
JWT_AUDIENCE=decisiongraph-api
AUDIT_REQUIRED=false
